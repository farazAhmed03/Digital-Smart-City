# Copy this file to deployment/env/.env.testing on your machine/runner.
# Never commit the real file. Values below are placeholders only.

PORT=5000
NODE_ENV=production

# Database - use MongoDB Atlas testing DB.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/digital_smart_city_test?retryWrites=true&w=majority
DB_URL=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/digital_smart_city_test?retryWrites=true&w=majority

JWT_SECRET=replace-with-long-random-value
JWT_KEY=replace-with-long-random-value
SESSION_SECRET=replace-with-long-random-value

CLOUDINARY_NAME=replace-cloud-name
CLOUDINARY_CLOUD_NAME=replace-cloud-name
CLOUDINARY_API_KEY=replace-api-key
CLOUDINARY_API_SECRET=replace-api-secret
LOCAL_UPLOAD_PATH=uploads

SMTP_HOST=smtp.gmail.com
SMTP_USER=replace@example.com
SMTP_PASS=replace-app-password
SMTP_MAIL=replace@example.com
SMTP_PASSWORD=replace-app-password

MERCHANT_ID=replace-payfast-merchant-id
MERCHANT_KEY=replace-payfast-merchant-key
PAYFAST_URL=https://sandbox.payfast.co.za/eng/process

STRIPE_PUBLIC_KEY=pk_test_replace
STRIPE_SECRET_KEY=sk_test_replace

SENTRY_DSN=https://replace@sentry.io/project
