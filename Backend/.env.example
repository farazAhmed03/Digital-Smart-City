# Digital Smart City Backend Runtime Environment
# Copy to Backend/.env only for local/manual tests. In AWS, store these values in AWS Secrets Manager.

NODE_ENV=production
PORT=5000

# Database - both names are supported by config/env.js
DB_URL=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Auth - both names are supported by config/env.js
JWT_KEY=<replace-with-strong-random-secret>
JWT_SECRET=<replace-with-strong-random-secret>
SESSION_SECRET=<replace-with-strong-random-secret>

# Frontend / CORS
CLIENT_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com,https://www.example.com
BASE_URL_PASSWORD_RESET=https://app.example.com/reset-password

# Email - aliases supported: SMTP_USER from SMTP_MAIL / MAIL_USER, SMTP_PASS from SMTP_PASSWORD / MAIL_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-app-password>
SMTP_FROM="Digital Smart City" <noreply@example.com>
SMTP_MAIL=<smtp-user>
SMTP_PASSWORD=<smtp-app-password>

# Cloudinary - aliases supported: CLOUDINARY_CLOUD_NAME from CLOUDINARY_NAME
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>
LOCAL_UPLOAD_PATH=uploads

# Payments
MERCHANT_ID=<payfast-merchant-id>
MERCHANT_KEY=<payfast-merchant-key>
PAYFAST_URL=https://sandbox.payfast.co.za/eng/process
RETURN_URL=https://api.example.com/api/payment/success
CANCEL_URL=https://api.example.com/api/payment/cancel
STRIPE_PUBLIC_KEY=<stripe-public-key>
STRIPE_SECRET_KEY=<stripe-secret-key>

# Observability
SENTRY_DSN=<sentry-dsn>
