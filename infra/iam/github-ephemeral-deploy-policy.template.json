{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TerraformEphemeralInfra",
      "Effect": "Allow",
      "Action": [
        "ec2:*Vpc*",
        "ec2:*Subnet*",
        "ec2:*InternetGateway*",
        "ec2:*Route*",
        "ec2:*SecurityGroup*",
        "ec2:Describe*",
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "elasticloadbalancing:*",
        "ecs:*",
        "application-autoscaling:*",
        "cloudwatch:*",
        "logs:*",
        "ecr:*",
        "secretsmanager:*",
        "iam:GetRole",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:PassRole",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": "*"
    }
  ]
}
